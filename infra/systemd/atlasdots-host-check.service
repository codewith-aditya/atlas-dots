[Unit]
Description=Check host storage, backup health and SSH access rules

[Service]
Type=oneshot
EnvironmentFile=-/etc/atlasdots/backup.env
ExecStart=/usr/local/sbin/atlasdots-host-check
StateDirectory=atlasdots/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/atlasdots/alerts
ProtectHome=true
PrivateTmp=true
