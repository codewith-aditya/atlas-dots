[Unit]
Description=Notify operators when a production backup fails

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/atlasdots-host-alert backup-failure "Nightly backup failed. Inspect atlasdots-backup.service on the server."
StateDirectory=atlasdots/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/atlasdots/alerts
PrivateTmp=true
