[Unit]
Description=Create and verify a Atlas Dots production backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/atlasdots/backup.env
ExecStart=/usr/local/sbin/atlasdots-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups
